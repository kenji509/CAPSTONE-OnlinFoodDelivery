<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.capstone.controller.LoginController"
      stylesheets="@style.css">
    <padding>
        <Insets top="50" right="45" bottom="50" left="45"/>
    </padding>

    <Label text="🍽️" style="-fx-font-size: 40px;"/>
    <Label text="Online Food Delivery System" styleClass="header-label"/>
    <Label text="Sign in to your account" styleClass="subheader-label"/>

    <VBox spacing="10" alignment="CENTER">
        <TextField fx:id="emailField" promptText="Email"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>
    </VBox>

    <Button text="Login" onAction="#onLoginButtonClick"/>
    <Hyperlink text="Don't have an account? Register" onAction="#onGoToRegisterClick"/>
    <Hyperlink text="🚴 Login as Rider instead" onAction="#onGoToRiderLoginClick"/>

    <Label fx:id="errorLabel" styleClass="error-label"/>
</VBox>
