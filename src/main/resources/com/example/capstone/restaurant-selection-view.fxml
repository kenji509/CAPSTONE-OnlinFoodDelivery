<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.capstone.controller.RestaurantSelectionController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="4">
            <Label text="🍽️  Choose a Restaurant" styleClass="header-bar-label"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-area" spacing="10">
            <ListView fx:id="restaurantListView"/>
            <Label fx:id="messageLabel" styleClass="error-label"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer-area" spacing="12" alignment="CENTER_RIGHT">
            <Button text="View Menu" onAction="#onViewMenuClick"/>
            <Button text="Logout" onAction="#onLogoutClick" styleClass="danger-button"/>
        </HBox>
    </bottom>

</BorderPane>
