<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.capstone.controller.MenuController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="4">
            <Label fx:id="restaurantNameLabel" styleClass="header-bar-label"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-area" spacing="10">
            <Label text="🍔  Menu Items" styleClass="subheader-label"/>
            <ListView fx:id="menuListView"/>
        </VBox>
    </center>

    <bottom>
        <VBox styleClass="footer-area" spacing="12">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="+ Add to Cart" onAction="#onAddToCartClick"/>
                <Label fx:id="cartLabel" text="🛒 Cart: 0 items" styleClass="subheader-label"/>
            </HBox>
            <GridPane hgap="6">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" halignment="CENTER"/>
                    <ColumnConstraints percentWidth="25" halignment="CENTER"/>
                    <ColumnConstraints percentWidth="25" halignment="CENTER"/>
                    <ColumnConstraints percentWidth="25" halignment="CENTER"/>
                </columnConstraints>
                <Button text="Checkout" onAction="#onCheckoutClick" styleClass="footer-button" maxWidth="Infinity" GridPane.columnIndex="0"/>
                <Button text="History" onAction="#onViewOrderHistoryClick" styleClass="footer-button,secondary-button" maxWidth="Infinity" GridPane.columnIndex="1"/>
                <Button text="Back" onAction="#onBackToRestaurantsClick" styleClass="footer-button,secondary-button" maxWidth="Infinity" GridPane.columnIndex="2"/>
                <Button text="Logout" onAction="#onLogoutClick" styleClass="footer-button,danger-button" maxWidth="Infinity" GridPane.columnIndex="3"/>
            </GridPane>
        </VBox>
    </bottom>

</BorderPane>