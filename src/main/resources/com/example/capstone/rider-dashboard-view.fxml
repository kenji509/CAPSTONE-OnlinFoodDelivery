<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.capstone.controller.RiderDashboardController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="4">
            <Label text="🚴  Rider Dashboard" styleClass="header-bar-label"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-area" spacing="10">
            <Label text="📦  Pending Orders" styleClass="subheader-label"/>
            <ListView fx:id="ordersListView"/>
        </VBox>
    </center>

    <bottom>
        <VBox styleClass="footer-area" spacing="8">
            <Label fx:id="statusLabel"/>
            <HBox spacing="10">
                <Button text="Accept Order" onAction="#onAcceptOrderClick"/>
                <Button text="Logout" onAction="#onLogoutClick" styleClass="danger-button"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
