<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.capstone.controller.AdminDashboardController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="4">
            <Label fx:id="titleLabel" styleClass="header-bar-label"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-area" spacing="10">
            <GridPane hgap="6">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" halignment="CENTER"/>
                    <ColumnConstraints percentWidth="33.33" halignment="CENTER"/>
                    <ColumnConstraints percentWidth="33.33" halignment="CENTER"/>
                </columnConstraints>
                <Button text="Users" onAction="#onViewUsersClick" styleClass="footer-button" maxWidth="Infinity" GridPane.columnIndex="0"/>
                <Button text="Restaurants" onAction="#onViewRestaurantsClick" styleClass="footer-button" maxWidth="Infinity" GridPane.columnIndex="1"/>
                <Button text="Reports" onAction="#onViewReportsClick" styleClass="footer-button" maxWidth="Infinity" GridPane.columnIndex="2"/>
            </GridPane>
            <TextArea fx:id="outputArea" editable="false" wrapText="true" prefHeight="450"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer-area" alignment="CENTER_RIGHT">
            <Button text="Logout" onAction="#onLogoutClick" styleClass="danger-button"/>
        </HBox>
    </bottom>

</BorderPane>