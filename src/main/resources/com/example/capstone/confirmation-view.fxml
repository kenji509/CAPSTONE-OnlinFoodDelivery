<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="14" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.capstone.controller.ConfirmationController"
      stylesheets="@style.css">
    <padding>
        <Insets top="45" right="45" bottom="45" left="45"/>
    </padding>

    <Label text="✅" style="-fx-font-size: 40px;"/>
    <Label text="Order Confirmed!" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>

    <VBox spacing="4" alignment="CENTER">
        <Label fx:id="orderIdLabel"/>
        <Label fx:id="statusLabel"/>
        <Label fx:id="totalLabel" styleClass="total-label"/>
        <Label fx:id="paymentLabel" styleClass="subheader-label"/>
    </VBox>

    <Button text="Cancel Order" onAction="#onCancelOrderClick" styleClass="danger-button"/>
    <Label fx:id="cancelMessageLabel"/>

    <Button text="⭐ Rate this Restaurant" onAction="#onRateRestaurantClick" styleClass="secondary-button"/>
    <Button text="← Back to Restaurants" onAction="#onBackToHomeClick" styleClass="secondary-button"/>
</VBox>
