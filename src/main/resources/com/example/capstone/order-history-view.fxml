<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.capstone.controller.OrderHistoryController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="4">
            <Label text="📋  Your Order History" styleClass="header-bar-label"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-area" spacing="10">
            <ListView fx:id="historyListView"/>
            <Label fx:id="emptyLabel" styleClass="subheader-label"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer-area" alignment="CENTER_RIGHT">
            <Button text="← Back to Restaurants" onAction="#onBackToHomeClick" styleClass="secondary-button"/>
        </HBox>
    </bottom>

</BorderPane>
