<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.capstone.controller.AdminDashboardController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="4">
            <Label fx:id="titleLabel" styleClass="header-bar-label"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-area" spacing="10">
            <HBox spacing="10">
                <Button text="👥 Users" onAction="#onViewUsersClick"/>
                <Button text="🍴 Restaurants" onAction="#onViewRestaurantsClick"/>
                <Button text="📊 Reports" onAction="#onViewReportsClick"/>
            </HBox>
            <TextArea fx:id="outputArea" editable="false" wrapText="true" prefHeight="450"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer-area" alignment="CENTER_RIGHT">
            <Button text="Logout" onAction="#onLogoutClick" styleClass="danger-button"/>
        </HBox>
    </bottom>

</BorderPane>
