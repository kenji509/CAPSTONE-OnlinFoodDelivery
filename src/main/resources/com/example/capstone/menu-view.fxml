<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.capstone.controller.MenuController"
            stylesheets="@style.css">

    <top>
        <VBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="4">
            <Label fx:id="restaurantNameLabel" styleClass="header-bar-label"/>
        </VBox>
    </top>

    <center>
        <VBox styleClass="content-area" spacing="10">
            <Label text="🍔  Menu Items" styleClass="subheader-label"/>
            <ListView fx:id="menuListView"/>
        </VBox>
    </center>

    <bottom>
        <VBox styleClass="footer-area" spacing="10">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="+ Add to Cart" onAction="#onAddToCartClick"/>
                <Label fx:id="cartLabel" text="🛒 Cart: 0 items" styleClass="subheader-label"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Checkout" onAction="#onCheckoutClick"/>
                <Button text="📋 Order History" onAction="#onViewOrderHistoryClick" styleClass="secondary-button"/>
                <Button text="← Restaurants" onAction="#onBackToRestaurantsClick" styleClass="secondary-button"/>
                <Button text="Logout" onAction="#onLogoutClick" styleClass="danger-button"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
