<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.capstone.controller.RegisterController"
      stylesheets="@style.css">
    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <Label text="🧾" style="-fx-font-size: 34px;"/>
    <Label text="Create Customer Account" styleClass="header-label"/>

    <TextField fx:id="nameField" promptText="Full Name"/>
    <TextField fx:id="emailField" promptText="Email"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>
    <TextField fx:id="contactField" promptText="Contact Number"/>
    <TextField fx:id="addressField" promptText="Delivery Address"/>

    <Button text="Register" onAction="#onRegisterButtonClick"/>
    <Label fx:id="messageLabel"/>

    <Button text="← Back to Login" onAction="#onGoToLoginClick" styleClass="secondary-button"/>
</VBox>
